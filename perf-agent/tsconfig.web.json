{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "noEmit": true
  },
  "include": ["web/**/*", "vite.config.ts"]
}
