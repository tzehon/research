{
  "name": "perf-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "demo": "node --import tsx src/cli.ts start",
    "demo:stop": "node --import tsx src/cli.ts stop",
    "demo:reset": "node --import tsx src/cli.ts reset",
    "demo:setup": "node --import tsx src/cli.ts setup",
    "demo:preflight": "node --import tsx src/cli.ts preflight",
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.app.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:protocol": "node --import tsx scripts/protocol-smoke.ts",
    "test:e2e": "node --import tsx scripts/e2e.ts",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "chrome-devtools-mcp": "1.10.1",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
